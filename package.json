{
  "name": "pixelsilo-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Custom code for the Pixel Silo Webflow site, built with Vite and served via jsDelivr.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "serve": "vite preview --host 127.0.0.1 --port 5500 --strictPort",
    "build": "node lottie/build.mjs && vite build",
    "lottie": "node lottie/build.mjs"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "lottie-web": "^5.12.2",
    "opentype.js": "^2.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
